# Copy this file to .env (in this folder, hw4/) and fill in your own values.
# Never commit the real .env (it is in .gitignore).

# Portkey API key used for all model calls (required for the chatbot)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional overrides (these are the defaults)
MODEL_NAME=gpt-5.6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1
